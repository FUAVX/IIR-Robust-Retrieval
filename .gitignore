# Keep datasets and prepared supervision outside Git.
# The upstream get_data_root() uses the repository's data/ directory.
data/
datasets/

# Checkpoints and model weights, including common upstream .pth.tar files.
checkpoints/
weights/
model_weights/
*.pth
*.pth.tar
*.pt
*.ckpt
*.safetensors
*.onnx
*.h5
*.hdf5
*.caffemodel

# Descriptor dumps and serialized experiment arrays/data.
descriptors/
descriptor_dumps/
*.npy
*.npz
*.pkl
*.pickle
*.mat
*.fvecs
*.bvecs

# All generated outputs are local artifacts, not experiment records.
outputs/

# Large reproduction bundles and raw execution logs stay outside Git.
*.zip
*.tar
*.tar.gz
*.tgz
*.log
logs/

# Keep only the final PDF for LaTeX-authored reproduction documents.
reproduction/**/LaTeX/
reproduction/**/*.tex
reproduction/**/*.bib
reproduction/**/*.cls
reproduction/**/*.sty
reproduction/**/*.aux
reproduction/**/*.blg
reproduction/**/*.bbl
reproduction/**/*.out
reproduction/**/*.synctex.gz

# Python and notebook caches.
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local execution state and duplicated Kaggle transport payloads.
/tmp/
*.tarpart
*.sqlite
artifacts/kaggle-posttraining/state/
artifacts/kaggle-posttraining/bundle/
artifacts/kaggle-posttraining/merged_results/
artifacts/revision-validation/jobs/
artifacts/revision-validation/publish/
